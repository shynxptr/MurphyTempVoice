# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Comma-separated Discord User IDs of AFK / Music bots that keep TempVoice channels alive (no time limit)
# Example: STAY_BOT_IDS=123456789012345678,987654321098765432
STAY_BOT_IDS=

# Set to "true" if ANY bot in a TempVoice channel should keep it alive (default: false, only STAY_BOT_IDS)
ALLOW_ANY_BOT_STAY=false

# Seconds to wait before deleting an empty TempVoice channel (protects against brief bot reconnects)
EMPTY_GRACE_SECONDS=15

# Anti-spam cooldown (seconds) for Join to Create per user
CREATE_COOLDOWN_SECONDS=3

# Optional: Auto-upload the 15 .webp icons as Discord Application Emojis on startup ("true" / "false")
AUTO_SYNC_APP_EMOJIS=true

